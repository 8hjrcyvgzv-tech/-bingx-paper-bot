{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bingx-v6-paper",
  "main": "V6_Explosive_Move_Engine.js",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "PAPER_TRACKER",
        "class_name": "PaperTracker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PaperTracker"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}

