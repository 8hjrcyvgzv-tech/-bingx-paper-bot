{
  "name": "bingx-paper-bot",
  "main": "worker_top100_v220_belit_breakout.js",
  "compatibility_date": "2026-08-28",
  "keep_vars": true,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAPER_TRACKER",
        "class_name": "PaperTracker"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
